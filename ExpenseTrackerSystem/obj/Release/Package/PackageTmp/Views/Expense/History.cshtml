@model IEnumerable<ExpenseTrackerSystem.Models.Expense>

@{
    ViewBag.Title = "History";
}

<!-- Toast Message -->
<style>
    .custom-toast {
        position: fixed;
        top: 60px;
        left: 50%;
        transform: translateX(-50%);
        width: fit-content;
        max-width: 80%;
        z-index: 9999;
        border-radius: 4px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, .2);
        padding: 12px 15px 12px 15px;
    }
</style>
@if (TempData["SuccessMsg"] != null)
{
    <div id="toast" class="custom-toast alert alert-success">
        @TempData["SuccessMsg"]
    </div>
}
@if (TempData["ErrorMsg"] != null)
{
    <div id="toast" class="custom-toast alert alert-danger">
        @TempData["ErrorMsg"]
    </div>
}

<div>
    <div class="clearfix">
        <h3 class="pull-left" style="margin-top: 20px;">
            Expenses
        </h3>

        <a href="@Url.Action("Create", "Expense")" class="btn btn-primary pull-right" style="margin-top: 20px;">
            + Add Expense
        </a>

        @using (Html.BeginForm("History", "Expense", FormMethod.Get))
        {
            <div class="pull-right" style="margin-top: 20px; margin-right: 20px">
                <select name="groupId" class="form-control" onchange="this.form.submit()">
                    @foreach (var item in ViewBag.Groups)
                    {
                        <option value="@item.GroupId" @(item.GroupId == ViewBag.GroupId ? "selected" : "")>
                            @item.GroupName
                        </option>
                    }
                </select>
            </div>
        }
    </div>
</div>
<hr />

<!-- Expense History Table -->
<div class="row">
    <div class="col-xs-12 col-sm-12 col-md-12">
        <div class="table-card">
            <div class="table-card-header">
                <span class="table-card-name">
                    Expense History
                </span>
            </div>

            <div class="table-card-body">
                <div class="expense-table-scroll">

                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Title</th>
                                <th>Group</th>
                                <th>Paid By</th>
                                <th>Amount</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Count() > 0)
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.ExpenseDate.ToShortDateString()</td>
                                        <td>@item.Title</td>
                                        <td>@item.Group.GroupName</td>
                                        <td>@item.PaidBy.Name</td>
                                        <td>₹ @Math.Round(item.Amount)</td>
                                        <td>
                                            @Html.ActionLink("Edit", "Edit", new { id = item.ExpenseId }, new { @class = "btn btn-warning btn-sm" })
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr class="text-center">
                                    <td colspan="6">No data.</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function OnDelete(id) {
        const isConfirmed = confirm("Are you sure you want to delete this item?");
        if (isConfirmed) {
            // Proceed with the deletion
            $.ajax({
                url: "/Expense/Delete",
                type: "POST",
                data: { Id: id },
                success: function (response) {
                    if (response == "1") {
                        alert("Item deleted successfully.");
                        window.location = "/Expense/Index";
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Deletion failed:", error);
                    alert("An error occurred while deleting the item. Please try again.");
                }
            });
        }
    }
</script>

<script>
    // Auto hide after 3 seconds
    setTimeout(function () {
        $("#toast").fadeOut(300);
    }, 5000);
</script>

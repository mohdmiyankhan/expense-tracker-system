@using ExpenseTrackerSystem.Helpers;
@model ExpenseTrackerSystem.Models.ViewModels.ReportVM

@{
    ViewBag.Title = "Expense Report";
}

<div>
    <div class="clearfix">
        <h3 class="pull-left" style="margin-top: 20px;">
            Expense Report
        </h3>

        @using (Html.BeginForm("Index", "Report", FormMethod.Get))
        {
            <div class="pull-right" style="margin-top: 20px;">
                <select name="groupId" class="form-control" onchange="this.form.submit()">
                    @foreach (var item in ViewBag.Groups)
                    {
                        <option value="@item.GroupId" @(item.GroupId == ViewBag.GroupId ? "selected" : "")>
                            @item.GroupName
                        </option>
                    }
                </select>
            </div>
        }
    </div>
</div>
<hr />

<!-- Cards -->
<div class="row">

    @foreach (var user in Model.Users)
    {
        <div class="col-md-3 col-sm-6">
            <div class="user-card">

                <!-- User Name -->
                @if (user.Balance > 0)
                {
                    <div class="user-card-header" style="background: #e6f9f0 !important;">
                        <span class="user-card-name">
                            @user.UserName
                        </span>
                    </div>
                }
                else if (user.Balance < 0)
                {
                    <div class="user-card-header" style="background: #fde8e8 !important;">
                        <span class="user-card-name">
                            @user.UserName
                        </span>
                    </div>
                }
                else
                {
                    <div class="user-card-header">
                        <span class="user-card-name">
                            @user.UserName
                        </span>
                    </div>
                }

                <div class="user-card-body">

                    <!-- Total Paid -->
                    <div class="amount-row">
                        <span>Total Paid</span>
                        <strong>
                            ₹ @user.TotalPaid
                        </strong>
                    </div>

                    <!-- Total Share -->
                    <div class="amount-row">
                        <span>Total Share</span>
                        <strong>
                            ₹ @user.TotalShare
                        </strong>
                    </div>

                    <hr />

                    <!-- Balance -->
                    <div class="balance-row">

                        @if (user.Balance > 0)
                        {
                            <span class="receive-text">
                                Will Receive
                            </span>

                            <strong class="receive-amount">
                                ₹ +@user.Balance
                            </strong>
                        }
                        else if (user.Balance < 0)
                        {
                            <span class="pay-text">
                                Will Pay
                            </span>

                            <strong class="pay-amount">
                                ₹ @user.Balance
                            </strong>
                        }
                        else
                        {
                            <span class="settled-text">
                                Settled
                            </span>

                            <strong>
                                ₹ 0
                            </strong>
                        }

                    </div>

                </div>

            </div>
        </div>
    }

</div>

<!-- Tabs: Balance Summary, Pending Settlements, Settlement History -->
<div class="report-tab-box">

    <ul class="nav nav-tabs" role="tablist">
        <li class="active">
            <a href="#summary" role="tab" data-toggle="tab">
                Balance Summary
                &nbsp;
                <span class="badge">@Model.Users.Count</span>
            </a>
        </li>

        <li>
            <a href="#pending" role="tab" data-toggle="tab">
                Pending Settlements
                &nbsp;
                <span class="badge">@Model.PendingSettlement.Count</span>
            </a>
        </li>

        <li>
            <a href="#history" role="tab" data-toggle="tab">
                Settlement History
                &nbsp;
                <span class="badge">@Model.SettlementHistory.Count</span>
            </a>
        </li>
    </ul>

    <div class="tab-content">

        <!-- User Balance Summary Content -->
        <div role="tabpanel" class="tab-pane active" id="summary">

            <div class="expense-table-scroll">

                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Paid</th>
                            <th>Share</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Users)
                        {
                            <tr>
                                <td>
                                    @item.UserName
                                </td>
                                <td>
                                    ₹ @item.TotalPaid
                                </td>
                                <td>
                                    ₹ @item.TotalShare
                                </td>
                                <td>
                                    @if (item.Balance > 0)
                                    {
                                        <span style="color:green">
                                            ₹ +@item.Balance
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="color:red">
                                            ₹ @item.Balance
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>

        </div>

        <!-- Pending Settlements Content -->
        <div role="tabpanel" class="tab-pane" id="pending">

            <div class="expense-table-scroll">

                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Person Who Pays</th>
                            <th>Person Who Receives</th>
                            <th>Amount</th>
                            <th>Action</th>
                            <th>Reminder</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.PendingSettlement)
                        {
                            string settlementData = "fromUserId=" + item.FromUserId + "&toUserId=" + item.ToUserId + "&amount=" + item.Amount;
                            int currentUserId = (int)Session["UserId"];
                            string encryptedUrl = UrlEncryptionHelper.Encrypt(settlementData);

                            <tr>
                                <td style="color:red;">
                                    @item.FromUser
                                </td>

                                <td style="color:green;">
                                    @item.ToUser
                                </td>

                                <td>₹ @item.Amount</td>

                                <td>
                                    @if (item.CanSettle)
                                    {
                                        @*using (Html.BeginForm("Settle", "Report"))
                                            {
                                                @Html.Hidden("fromUserId", item.FromUserId)
                                                @Html.Hidden("toUserId", item.ToUserId)
                                                @Html.Hidden("amount", item.Amount)

                                                <button class="btn btn-success btn-sm">
                                                    Settle Now
                                                </button>
                                            }*@
                                        <a href="/Expense/Settle?data=@encryptedUrl" class="btn btn-success btn-sm" target="_blank">
                                            Settle Now
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted"
                                              style="color: #000000; padding: 3px 10px 3px 10px; background-color: #ffd11a; border-radius: 3rem; ">
                                            Pending
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (currentUserId == item.ToUserId)
                                    {
                                        <button type="button" class="btn btn-success btn-sm" style=" padding: 2px 10px !important;"
                                                onclick="openWhatsApp('@item.FromUserId', '@item.ToUserId', '@item.Amount', '@settlementData')">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-whatsapp" viewBox="0 0 16 16"
                                                 style=" margin-top: 5px !important;">
                                                <path d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.73.73 0 0 0-.529.247c-.182.198-.691.677-.691 1.654s.71 1.916.81 2.049c.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232" />
                                            </svg>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>

        </div>

        <!-- Settlement History Content -->
        <div role="tabpanel" class="tab-pane" id="history">

            <div class="expense-table-scroll">

                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Paid By</th>
                            <th>Received By</th>
                            <th>Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.SettlementHistory)
                        {
                            <tr>
                                <td>
                                    @item.Date.ToString("dd-MM-yyyy")
                                </td>

                                <td>@item.FromUser</td>

                                <td>@item.ToUser</td>

                                <td>
                                    ₹ @item.Amount
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>

        </div>

    </div>

</div>

<script>
    function openWhatsApp(fromUserId, toUserId, amount, settlementData) {
        $.post('/Reminder/WhatsAppReminder',
            {
                fromUserId: fromUserId,
                toUserId: toUserId,
                amount: amount,
                settlementData: settlementData
            },
            function (url) {
                window.open(url, '_blank');
            });
    }
</script>


<!-- Toast Message -->
<style>
    .custom-toast {
        position: fixed;
        top: 60px;
        left: 50%;
        transform: translateX(-50%);
        width: fit-content;
        max-width: 80%;
        z-index: 9999;
        border-radius: 4px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, .2);
        padding: 12px 15px 12px 15px;
    }
</style>
@if (TempData["SuccessMsg"] != null)
{
    <div id="toast" class="custom-toast alert alert-success">
        @TempData["SuccessMsg"]
    </div>
}
@if (TempData["ErrorMsg"] != null)
{
    <div id="toast" class="custom-toast alert alert-danger">
        @TempData["ErrorMsg"]
    </div>
}
<script>
    // Auto hide after 3 seconds
    setTimeout(function () {
        $("#toast").fadeOut(300);
    }, 5000);
</script>
